<UserControl x:Class="SCEWIN_Studio.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SCEWIN_Studio.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Page Title -->
            <TextBlock Text="{Binding L10n[Nav_Memory]}"
                       FontWeight="Bold"
                       FontSize="24"
                       Foreground="#FFFFFF" />
            <TextBlock Text="{Binding L10n[Mem_TimingsDesc]}"
                       FontSize="13"
                       Margin="0,6,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- SubCategory Filter Pills -->
            <WrapPanel Margin="0,0,0,10">
                <Button Content="{Binding L10n[Filter_All]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="All">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="All">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_PrimaryTimings]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="PrimaryTimings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="PrimaryTimings">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_SecondaryTimings]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="SecondaryTimings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="SecondaryTimings">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_TertiaryTimings]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="TertiaryTimings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="TertiaryTimings">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_TerminationsGdm]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="TerminationsGdm">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="TerminationsGdm">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_Voltages]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="Voltages">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="Voltages">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_Frequency]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="Frequency">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="Frequency">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>

            <!-- Memory Architecture Tier Filter Pills -->
            <WrapPanel Margin="0,0,0,16">
                <Button Content="Все уровни"
                        Command="{Binding SetMemoryTierFilterCommand}"
                        CommandParameter="All">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemoryTierFilter}" Value="All">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="AMD CBS (Основной)"
                        Command="{Binding SetMemoryTierFilterCommand}"
                        CommandParameter="Tier1Cbs">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemoryTierFilter}" Value="Tier1Cbs">
                                    <Setter Property="Background" Value="#14341F" />
                                    <Setter Property="BorderBrush" Value="#4ADE80" />
                                    <Setter Property="Foreground" Value="#4ADE80" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="MSI Click BIOS (0=Auto)"
                        Command="{Binding SetMemoryTierFilterCommand}"
                        CommandParameter="Tier2Msi">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemoryTierFilter}" Value="Tier2Msi">
                                    <Setter Property="Background" Value="#182A38" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="AMD PBS (Дубликаты)"
                        Command="{Binding SetMemoryTierFilterCommand}"
                        CommandParameter="Tier3Pbs">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemoryTierFilter}" Value="Tier3Pbs">
                                    <Setter Property="Background" Value="#2B2B2B" />
                                    <Setter Property="BorderBrush" Value="#888888" />
                                    <Setter Property="Foreground" Value="#E0E0E0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Общие (Voltages/Misc)"
                        Command="{Binding SetMemoryTierFilterCommand}"
                        CommandParameter="General">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemoryTierFilter}" Value="General">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>

            <!-- Collapsible Architectural Details -->
            <StackPanel Margin="0,0,0,12">
                <!-- TIER 2: Secondary MSI Click BIOS Tokens (Wrapped in collapsible Expander) -->
                <Border CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMsiOverlayTokens}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Expander Header="{Binding L10n[Mem_MsiOverlayHeader], FallbackValue='⚙️ Оверлей MSI Click BIOS (числовой ввод, 0 = Auto)'}"
                              IsExpanded="False"
                              Padding="16,10"
                              Background="Transparent"
                              BorderThickness="0">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#60CDFF" />
                                    <Border Margin="12,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="#182A38"
                                            BorderBrush="#254B69"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.L10n[Mem_MsiOverlayBadge], RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='OEM Оверлей'}" FontSize="10" FontWeight="SemiBold" Foreground="#60CDFF" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="OEM-оверлей MSI Click BIOS OC Engine (Setup VarStore). Если в поле установлено 0, действует режим Auto и вступают в силу аппаратные регистры AMD CBS. При вводе числа PEI-модуль MSI переопределяет CBS."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <Button Content="Показать только параметры MSI Click BIOS в списке"
                                    Command="{Binding SetMemoryTierFilterCommand}"
                                    CommandParameter="Tier2Msi"
                                    Style="{StaticResource FluentPillFilterButtonStyle}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- TIER 3: AMD Overclocking PBS Tokens (Wrapped in collapsible Expander) -->
                <Border CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPbsDuplicateTokens}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Expander Header="{Binding L10n[Mem_PbsHeader], FallbackValue='📦 Служебные дубликаты AMD Overclocking (по умолчанию Auto)'}"
                              IsExpanded="False"
                              Padding="16,10"
                              Background="Transparent"
                              BorderThickness="0">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#B0B0B0" />
                                    <Border Margin="12,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="#2B2B2B"
                                            BorderBrush="#444444"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.L10n[Mem_PbsBadge], RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='AMD PBS'}" FontSize="10" FontWeight="SemiBold" Foreground="#888888" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Служебное дублирующее меню AMD Overclocking PBS. По умолчанию все параметры находятся в Auto (*[FF]Auto) и зеркалируют первичное дерево настроек."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <Button Content="Показать только параметры AMD PBS в списке"
                                    Command="{Binding SetMemoryTierFilterCommand}"
                                    CommandParameter="Tier3Pbs"
                                    Style="{StaticResource FluentPillFilterButtonStyle}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Fully Virtualized ListView for Memory Tokens -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding FilteredMemoryTokens}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.CacheLengthUnit="Item"
                  VirtualizingPanel.CacheLength="3,3"
                  VirtualizingPanel.IsContainerVirtualizable="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <controls:TokenCard />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
