<UserControl x:Class="SCEWIN_Studio.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SCEWIN_Studio.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1000">
            <!-- Page Title -->
            <TextBlock Text="{Binding L10n[Nav_Memory]}"
                       FontWeight="Bold"
                       FontSize="24"
                       Foreground="#FFFFFF" />
            <TextBlock Text="{Binding L10n[Mem_TimingsDesc]}"
                       FontSize="13"
                       Margin="0,6,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- SubCategory Filter Pills -->
            <WrapPanel Margin="0,0,0,16">
                <Button Content="{Binding L10n[Filter_All]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="All">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="All">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_PrimaryTimings]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="PrimaryTimings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="PrimaryTimings">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_SecondaryTimings]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="SecondaryTimings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="SecondaryTimings">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_TertiaryTimings]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="TertiaryTimings">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="TertiaryTimings">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_TerminationsGdm]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="TerminationsGdm">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="TerminationsGdm">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_Voltages]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="Voltages">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="Voltages">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_Frequency]}"
                        Command="{Binding SetMemorySubCategoryCommand}"
                        CommandParameter="Frequency">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MemorySubCategory}" Value="Frequency">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>

            <!-- AM4 Architecture Explainer Banner -->
            <Border CornerRadius="8"
                    Background="#182533"
                    BorderBrush="#254B69"
                    BorderThickness="1"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMsiOverlayTokens}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="💡" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Архитектура деревьев таймингов AMD AM4 / MSI Click BIOS"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#60CDFF" />
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="0,6,0,0"
                                   Foreground="#CCCCCC">
                            На материнских платах AMD AM4 (MSI B550) управление таймингами разделено на 3 независимых уровня:<LineBreak />
                            • <Bold Foreground="#4ADE80">Tier 1 (AMD CBS, AmdSetup):</Bold> Аппаратные регистры AGESA в hex-формате (10h Clk = 16, 12h = 18, 26h = 38). При значении 0 (Auto) в оверлее MSI именно они применяются процессором напрямую.<LineBreak />
                            • <Bold Foreground="#60CDFF">Tier 2 (MSI Click BIOS OC Engine, Setup):</Bold> OEM-оверлей ручного ввода (0 = Auto). При ненулевом значении PEI-драйвер MSI переопределяет регистры CBS на этапе POST.<LineBreak />
                            • <Bold Foreground="#B0B0B0">Tier 3 (AMD Overclocking PBS):</Bold> Служебное дублирующее меню настроек (по умолчанию Auto).
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TIER 1: Primary AMD CBS (Directly visible at the top) -->
            <StackPanel Margin="0,0,0,24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFilteredPrimaryCbsTokens}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Основной контроль: AMD CBS (AmdSetup)"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="Аппаратные шестнадцатеричные регистры AGESA (10h Clk = 16, 12h = 18, 26h = 38). Применяются процессором напрямую при значении 0 в оверлее MSI."
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="8,3"
                            CornerRadius="4"
                            Background="#14341F"
                            BorderBrush="#256B3D"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="Основной / AMD CBS" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding FilteredPrimaryCbsMemoryTokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TokenCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- TIER 2: Secondary MSI Click BIOS Tokens (Wrapped in collapsible Expander / spoiler) -->
            <Border CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFilteredMsiOverlayTokens}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Expander Header="⚙️ Оверлей MSI Click BIOS (числовой ввод, 0 = Auto)"
                          IsExpanded="False"
                          Padding="16,12"
                          Background="Transparent"
                          BorderThickness="0">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#60CDFF" />
                                <Border Margin="12,0,0,0"
                                        Padding="6,1"
                                        CornerRadius="4"
                                        Background="#182A38"
                                        BorderBrush="#254B69"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="OEM Оверлей" FontSize="10" FontWeight="SemiBold" Foreground="#60CDFF" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="OEM-оверлей MSI Click BIOS OC Engine (Setup VarStore). Если в поле установлено 0, действует режим Auto и вступают в силу аппаратные регистры AMD CBS. При вводе числа PEI-модуль MSI переопределяет CBS."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding FilteredMsiOverlayMemoryTokens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TokenCard />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- TIER 3: AMD Overclocking PBS Tokens (Wrapped in collapsible Expander / spoiler) -->
            <Border CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFilteredPbsDuplicateTokens}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Expander Header="📦 Служебные дубликаты AMD Overclocking (по умолчанию Auto)"
                          IsExpanded="False"
                          Padding="16,12"
                          Background="Transparent"
                          BorderThickness="0">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#B0B0B0" />
                                <Border Margin="12,0,0,0"
                                        Padding="6,1"
                                        CornerRadius="4"
                                        Background="#2B2B2B"
                                        BorderBrush="#444444"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="AMD PBS" FontSize="10" FontWeight="SemiBold" Foreground="#888888" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </Expander.HeaderTemplate>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Служебное дублирующее меню AMD Overclocking PBS. По умолчанию все параметры находятся в Auto (*[FF]Auto) и зеркалируют первичное дерево настроек."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding FilteredPbsDuplicateMemoryTokens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TokenCard />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- General Memory Settings (if any non-tiered memory tokens exist) -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFilteredGeneralMemoryTokens}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Общие параметры контроллера памяти (DRAM / Interleaving / Voltages)"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#FFFFFF"
                           Margin="0,8,0,12" />
                <ItemsControl ItemsSource="{Binding FilteredGeneralMemoryTokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TokenCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Fallback if no tiered collections exist (generic dumps) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasFilteredPrimaryCbsTokens}" Value="False" />
                                    <Condition Binding="{Binding HasFilteredMsiOverlayTokens}" Value="False" />
                                    <Condition Binding="{Binding HasFilteredPbsDuplicateTokens}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ItemsControl ItemsSource="{Binding FilteredMemoryTokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TokenCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
