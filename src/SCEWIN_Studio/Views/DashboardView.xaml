<UserControl x:Class="SCEWIN_Studio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SCEWIN_Studio.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1000">

            <!-- Hero Banner Card -->
            <Border CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding L10n[Dash_BannerTitle]}"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       FontSize="22" />
                        </StackPanel>

                        <TextBlock Text="{Binding L10n[Dash_BannerDesc]}"
                                   FontSize="13"
                                   Margin="0,6,0,16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- Quick metrics grid -->
                        <WrapPanel>
                            <!-- Status -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="12,8" CornerRadius="6" Margin="0,0,10,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L10n[Dash_Motherboard]}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding MotherboardSummary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                </StackPanel>
                            </Border>

                            <!-- HII CRC32 -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="12,8" CornerRadius="6" Margin="0,0,10,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L10n[Dash_HiiCrc]}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding CurrentDump.HiiCrc32, FallbackValue='—'}" FontWeight="Bold" FontSize="13" Foreground="#60CDFF" />
                                </StackPanel>
                            </Border>

                            <!-- Total Tokens -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="12,8" CornerRadius="6" Margin="0,0,10,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L10n[Dash_TotalTokens]}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding CurrentDump.TotalTokens, FallbackValue='0'}" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <!-- Modified Count -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="12,8" CornerRadius="6" Margin="0,0,10,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L10n[Dash_ModifiedCount]}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding ModifiedCount}" FontWeight="Bold" FontSize="13" Foreground="#51CF66" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="{Binding L10n[Btn_ExportNvram]}"
                                Style="{StaticResource FluentAccentButtonStyle}"
                                Height="36"
                                Margin="0,0,0,8"
                                Command="{Binding ExportFromBiosCommand}" />

                        <Button Content="{Binding L10n[Btn_LoadDump]}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Height="32"
                                Command="{Binding OpenDumpFileDialogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SCEWIN Utility Detection Status Card -->
            <Border CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⚠️" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDriversReady}" Value="True">
                                                <Setter Property="Text" Value="✅" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding L10n[Dash_ScewinStatus]}" FontWeight="SemiBold" FontSize="14" />

                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#33FFA000" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDriversReady}" Value="True">
                                                <Setter Property="Background" Value="#3300C853" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding L10n[Status_DriversMissing]}" />
                                            <Setter Property="Foreground" Value="#FFA000" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDriversReady}" Value="True">
                                                    <Setter Property="Text" Value="{Binding L10n[Status_DriversReady]}" />
                                                    <Setter Property="Foreground" Value="#00C853" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding ScewinPath, FallbackValue='SCEWIN_64.exe не обнаружен. Нажмите кнопку автопоиска или укажите файл вручную.'}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Buttons for detection -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding L10n[Btn_AutoDetect]}"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding RunAutoDetectCommand}" />

                        <Button Content="{Binding L10n[Btn_BrowseScewin]}"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding BrowseScewinPathCommand}" />

                        <Button Content="{Binding L10n[Btn_DownloadScewin]}"
                                Style="{StaticResource FluentAccentButtonStyle}"
                                Command="{Binding DownloadLatestScewinCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section: Quick Tweaks (ASPM & C-States) -->
            <TextBlock Text="{Binding L10n[Dash_QuickPicks]}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding QuickTweakTokens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TokenCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
