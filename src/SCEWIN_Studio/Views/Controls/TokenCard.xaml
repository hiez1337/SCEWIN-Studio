<UserControl x:Class="SCEWIN_Studio.Views.Controls.TokenCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700">
    <Border CornerRadius="8"
            BorderThickness="1"
            Padding="16,14"
            Margin="0,0,0,10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeColorDefaultBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                        <Setter Property="BorderBrush" Value="#60CDFF" />
                        <Setter Property="Background" Value="#253545" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Icon (Clean glyph matching mockup) -->
            <TextBlock Grid.Column="0"
                       Text="{Binding IconGlyph}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="20"
                       Foreground="#60CDFF"
                       Margin="2,4,16,0"
                       VerticalAlignment="Top" />

            <!-- Column 1: Title, Badges, Inline Spoiler, Collapsible Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayTitle}"
                               ToolTip="{Binding Question}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               MaxWidth="380"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Optimal Badge -->
                    <Border Margin="8,0,0,0"
                            Padding="8,2"
                            CornerRadius="10"
                            Background="{StaticResource OptimalBadgeBgBrush}"
                            BorderBrush="{StaticResource OptimalBadgeBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOptimal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✔ " FontSize="10" Foreground="{StaticResource OptimalBadgeTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Optimal" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OptimalBadgeTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Modified Tag -->
                    <Border Margin="8,0,0,0"
                            Padding="6,1"
                            CornerRadius="4"
                            Background="#330078D4"
                            BorderBrush="#60CDFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="MODIFIED" FontSize="10" FontWeight="Bold" Foreground="#60CDFF" VerticalAlignment="Center" />
                    </Border>

                    <!-- Tier 1: AMD CBS Green Badge -->
                    <Border Margin="8,0,0,0"
                            Padding="7,2"
                            CornerRadius="4"
                            Background="#14341F"
                            BorderBrush="#256B3D"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="AMD CBS (AmdSetup) — основные аппаратные регистры AGESA (10h Clk = 16, 12h = 18, 26h = 38). Применяются при 0 в оверлее MSI.">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTier1Cbs}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Основной / AMD CBS" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" VerticalAlignment="Center" />
                    </Border>

                    <!-- Tier 2: MSI Click BIOS Cyan Badge -->
                    <Border Margin="8,0,0,0"
                            Padding="7,2"
                            CornerRadius="4"
                            Background="#182A38"
                            BorderBrush="#254B69"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="MSI Click BIOS OC Engine (Setup) — OEM оверлей. 0 = Auto (применяются регистры CBS). Ненулевое значение переопределяет CBS.">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTier2Msi}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Оверлей MSI BIOS (0 = Auto)" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" VerticalAlignment="Center" />
                    </Border>

                    <!-- Tier 3: AMD PBS Gray Badge -->
                    <Border Margin="8,0,0,0"
                            Padding="7,2"
                            CornerRadius="4"
                            Background="#2B2B2B"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="AMD Overclocking PBS — служебное дублирующее меню. По умолчанию Auto.">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTier3Pbs}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Служебный дубликат / AMD PBS" FontSize="11" FontWeight="SemiBold" Foreground="#B0B0B0" VerticalAlignment="Center" />
                    </Border>
                </WrapPanel>

                <!-- Spoiler Toggle Button (Variant 1: Inline Chevron Expander) -->
                <Button Style="{StaticResource FluentSpoilerHyperlinkButtonStyle}"
                        Command="{Binding ToggleDetailsCommand}"
                        FocusVisualStyle="{x:Null}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#60CDFF" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Описание и детали ▾" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True">
                                            <Setter Property="Text" Value="Скрыть описание ▴" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Collapsible Recessed Details Panel -->
                <Border CornerRadius="6"
                        Background="#1A1A1A"
                        BorderBrush="#2F2F2F"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,6,0,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- Full Help String from BIOS NVRAM -->
                        <TextBlock Text="{Binding HelpString}"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,8" />

                        <!-- Timing subtitle if available -->
                        <TextBlock Text="{Binding TimingSubtitle}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   Foreground="#60CDFF"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTimingSubtitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Info banner if available (e.g. Bifurcation) -->
                        <Border Margin="0,0,0,8"
                                Padding="8,5"
                                CornerRadius="4"
                                Background="#142433"
                                BorderBrush="#204060"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInfoBanner}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding InfoBannerText}" FontSize="11" Foreground="#9BDCFF" TextWrapping="Wrap" />
                        </Border>

                        <!-- Bottom technical metadata badges -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#242424" BorderBrush="#353535" BorderThickness="1" Padding="6,2" CornerRadius="4" Margin="0,0,6,0">
                                <TextBlock Text="{Binding TokenId, StringFormat='Token: 0x{0}'}" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <Border Background="#242424" BorderBrush="#353535" BorderThickness="1" Padding="6,2" CornerRadius="4" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Offset, StringFormat='Offset: 0x{0}'}" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <Border Background="#242424" BorderBrush="#353535" BorderThickness="1" Padding="6,2" CornerRadius="4" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Width, StringFormat='Width: {0}'}" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <Border Background="#242424" BorderBrush="#353535" BorderThickness="1" Padding="6,2" CornerRadius="4">
                                <TextBlock Text="{Binding SafetyLevel}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextFillColorTertiaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Column 2: Interactive Controls & Reset Button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Dropdown when options are available and not binary toggle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasOptions}" Value="True" />
                                        <Condition Binding="{Binding IsBinaryToggle}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ComboBox Style="{StaticResource FluentCardComboBoxStyle}"
                              ItemsSource="{Binding Options}"
                              SelectedItem="{Binding CurrentOption, Mode=TwoWay}"
                              DisplayMemberPath="FormattedDisplayText"
                              MinWidth="190"
                              MaxWidth="280" />
                </StackPanel>

                <!-- ToggleSwitch for binary (Enabled/Disabled, On/Off) options -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBinaryToggle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ToggleStatusText}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ui:ToggleSwitch IsOn="{Binding IsChecked, Mode=TwoWay}"
                                     OnContent=""
                                     OffContent=""
                                     VerticalAlignment="Center" />
                </StackPanel>

                <!-- Stepper Box when numeric stepper -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasOptions}" Value="False" />
                                        <Condition Binding="{Binding IsNumericStepper}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="−"
                            Command="{Binding DecrementNumericCommand}"
                            Style="{StaticResource FluentStepperButtonStyle}" />
                    <TextBox Style="{StaticResource FluentCardNumericTextBoxStyle}"
                             Text="{Binding CustomNumericValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             Width="60"
                             Margin="4,0" />
                    <Button Content="+"
                            Command="{Binding IncrementNumericCommand}"
                            Style="{StaticResource FluentStepperButtonStyle}" />

                    <!-- 0 = Auto badge for MSI Click BIOS overlay -->
                    <Border Margin="8,0,0,0"
                            Padding="6,2"
                            CornerRadius="4"
                            Background="#182A38"
                            BorderBrush="#254B69"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTip="0 = Auto (вступают в силу аппаратные регистры AMD CBS)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsZeroAuto}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="0 = Auto" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Standard text box when non-stepper free value -->
                <TextBox Text="{Binding CustomNumericValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         MinWidth="120">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource FluentCardNumericTextBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasOptions}" Value="False" />
                                        <Condition Binding="{Binding IsNumericStepper}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Info Tooltip button in Column 2 -->
                <Border Width="24" Height="24"
                        CornerRadius="12"
                        Background="#242424"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="{Binding InfoTooltipText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInfoTooltip}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="ⓘ" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Reset Button -->
                <Button Margin="8,0,0,0"
                        Width="32" Height="32"
                        Padding="0"
                        ToolTip="Reset to original value"
                        Click="OnResetClicked">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HeaderActionButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="↺" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
