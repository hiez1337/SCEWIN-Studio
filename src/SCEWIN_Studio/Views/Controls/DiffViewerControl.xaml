<UserControl x:Class="SCEWIN_Studio.Views.Controls.DiffViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="700">
    <Border Background="#1C1C1C"
            BorderBrush="#2B2B2B"
            BorderThickness="1,0,0,0">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding L10n[Diff_SideBySideTitle], FallbackValue='Pending Changes &amp; Diff Preview'}"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#FFFFFF" />
            </StackPanel>

            <!-- Side-by-Side Column Headers -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding L10n[Diff_CurrentNvram], FallbackValue='Current NVRAM'}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="#8E8E8E" />
                <TextBlock Grid.Column="1"
                           Text="vs"
                           FontSize="11"
                           Foreground="#6E6E6E"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding L10n[Diff_ProposedValues], FallbackValue='Proposed Values'}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="#8E8E8E"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Diff list or Empty Placeholder -->
            <Grid Grid.Row="2">
                <!-- Placeholder when empty -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasModifiedItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="56" Height="56" CornerRadius="28" Background="#242424" BorderBrush="#333333" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="&#xF0E3;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding L10n[Diff_Empty]}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="#888888" />
                </StackPanel>

                <!-- Side-by-Side Diff Items List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasModifiedItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding PendingDiffs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="#262626"
                                        BorderBrush="#383838"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <!-- Question Title & Token -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding TokenId, StringFormat='0x{0}'}"
                                                       DockPanel.Dock="Right"
                                                       FontSize="10"
                                                       Foreground="#757575"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Question}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Side-by-side values -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Old Value (Current NVRAM, Red Tint) -->
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource DiffRedBgBrush}"
                                                    BorderBrush="{StaticResource DiffRedBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,4">
                                                <TextBlock Text="{Binding OldValue}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource DiffRedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- Arrow -->
                                            <TextBlock Grid.Column="1"
                                                       Text="→"
                                                       FontSize="11"
                                                       Foreground="#6E6E6E"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                            <!-- New Value (Proposed Values, Green Tint) -->
                                            <Border Grid.Column="2"
                                                    Background="{StaticResource DiffGreenBgBrush}"
                                                    BorderBrush="{StaticResource DiffGreenBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,4">
                                                <TextBlock Text="{Binding NewValue}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource DiffGreenTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <!-- Apply to NVRAM Button (Accent Sky Blue) -->
                <Button AutomationProperties.AutomationId="Btn_ApplyChanges"
                        Content="{Binding L10n[Btn_ApplyDiff], FallbackValue='Apply to NVRAM (SCEWIN /i)'}"
                        Style="{StaticResource FluentAccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="38"
                        Command="{Binding ApplyChangesCommand}"
                        IsEnabled="{Binding HasModifiedItems}" />

                <!-- Apply & Reboot Button -->
                <Button AutomationProperties.AutomationId="Btn_ApplyAndReboot"
                        Content="{Binding L10n[Btn_ApplyAndReboot], FallbackValue='Apply &amp; Reboot'}"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="34"
                        Margin="0,8,0,0"
                        Command="{Binding ApplyAndRebootCommand}"
                        IsEnabled="{Binding HasModifiedItems}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
