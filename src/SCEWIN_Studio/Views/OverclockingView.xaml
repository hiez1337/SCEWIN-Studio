<UserControl x:Class="SCEWIN_Studio.Views.OverclockingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SCEWIN_Studio.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1000">
            <TextBlock Text="{Binding L10n[Nav_Overclocking]}"
                       FontWeight="Bold"
                       FontSize="24"
                       Foreground="#FFFFFF" />
            <TextBlock Text="{Binding L10n[Ovc_PboDesc]}"
                       FontSize="13"
                       Margin="0,6,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- SubCategory Filter Pills -->
            <WrapPanel Margin="0,0,0,16">
                <Button Content="{Binding L10n[Filter_All]}"
                        Command="{Binding SetOverclockingSubCategoryCommand}"
                        CommandParameter="All">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverclockingSubCategory}" Value="All">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_PboCurve]}"
                        Command="{Binding SetOverclockingSubCategoryCommand}"
                        CommandParameter="PboCurve">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverclockingSubCategory}" Value="PboCurve">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_PboLimits]}"
                        Command="{Binding SetOverclockingSubCategoryCommand}"
                        CommandParameter="PboLimits">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverclockingSubCategory}" Value="PboLimits">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_CpuPowerStates]}"
                        Command="{Binding SetOverclockingSubCategoryCommand}"
                        CommandParameter="CpuPowerStates">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverclockingSubCategory}" Value="CpuPowerStates">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding L10n[Filter_CpuTopology]}"
                        Command="{Binding SetOverclockingSubCategoryCommand}"
                        CommandParameter="CpuTopology">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FluentPillFilterButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverclockingSubCategory}" Value="CpuTopology">
                                    <Setter Property="Background" Value="#1C384F" />
                                    <Setter Property="BorderBrush" Value="#60CDFF" />
                                    <Setter Property="Foreground" Value="#60CDFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding FilteredOverclockingTokens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TokenCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
