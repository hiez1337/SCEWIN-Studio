<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019">

    <!-- Windows 11 Fluent Dark Palette -->
    <Color x:Key="SolidBackgroundFillColorBase">#202020</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#1A1A1A</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#282828</Color>
    <Color x:Key="CardBackgroundFillColorDefault">#2B2B2B</Color>
    <Color x:Key="CardBackgroundFillColorSecondary">#242424</Color>
    <Color x:Key="CardStrokeColorDefault">#383838</Color>
    <Color x:Key="ControlFillColorDefault">#2F2F2F</Color>
    <Color x:Key="ControlFillColorSecondary">#383838</Color>
    <Color x:Key="ControlStrokeColorDefault">#444444</Color>
    <Color x:Key="SubtleBorderColor">#2F2F2F</Color>

    <!-- Accent: Windows 11 Cyan / Light Sky Blue -->
    <Color x:Key="SystemAccentColor">#60CDFF</Color>
    <Color x:Key="SystemAccentColorLight">#75D5FF</Color>
    <Color x:Key="SystemAccentColorDark">#41B6E6</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="StatusGreenBg">#132E1D</Color>
    <Color x:Key="StatusGreenBorder">#235E35</Color>
    <Color x:Key="StatusGreenText">#86EFAC</Color>
    <Color x:Key="StatusGreenDot">#22C55E</Color>

    <Color x:Key="OptimalBadgeBg">#14341F</Color>
    <Color x:Key="OptimalBadgeBorder">#256B3D</Color>
    <Color x:Key="OptimalBadgeText">#4ADE80</Color>

    <Color x:Key="DiffRedBg">#3A1818</Color>
    <Color x:Key="DiffRedBorder">#5E2424</Color>
    <Color x:Key="DiffRedText">#FFA39E</Color>

    <Color x:Key="DiffGreenBg">#163820</Color>
    <Color x:Key="DiffGreenBorder">#256637</Color>
    <Color x:Key="DiffGreenText">#7EE787</Color>

    <!-- Text Colors -->
    <Color x:Key="TextFillColorPrimary">#FFFFFF</Color>
    <Color x:Key="TextFillColorSecondary">#9E9E9E</Color>
    <Color x:Key="TextFillColorTertiary">#757575</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource SolidBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource SolidBackgroundFillColorTertiary}" />
    
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource CardStrokeColorDefault}" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />

    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="AccentColorBrush" Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="AccentColorLightBrush" Color="{StaticResource SystemAccentColorLight}" />
    
    <SolidColorBrush x:Key="StatusGreenBgBrush" Color="{StaticResource StatusGreenBg}" />
    <SolidColorBrush x:Key="StatusGreenBorderBrush" Color="{StaticResource StatusGreenBorder}" />
    <SolidColorBrush x:Key="StatusGreenTextBrush" Color="{StaticResource StatusGreenText}" />
    <SolidColorBrush x:Key="StatusGreenDotBrush" Color="{StaticResource StatusGreenDot}" />

    <SolidColorBrush x:Key="OptimalBadgeBgBrush" Color="{StaticResource OptimalBadgeBg}" />
    <SolidColorBrush x:Key="OptimalBadgeBorderBrush" Color="{StaticResource OptimalBadgeBorder}" />
    <SolidColorBrush x:Key="OptimalBadgeTextBrush" Color="{StaticResource OptimalBadgeText}" />

    <SolidColorBrush x:Key="DiffRedBgBrush" Color="{StaticResource DiffRedBg}" />
    <SolidColorBrush x:Key="DiffRedBorderBrush" Color="{StaticResource DiffRedBorder}" />
    <SolidColorBrush x:Key="DiffRedTextBrush" Color="{StaticResource DiffRedText}" />

    <SolidColorBrush x:Key="DiffGreenBgBrush" Color="{StaticResource DiffGreenBg}" />
    <SolidColorBrush x:Key="DiffGreenBorderBrush" Color="{StaticResource DiffGreenBorder}" />
    <SolidColorBrush x:Key="DiffGreenTextBrush" Color="{StaticResource DiffGreenText}" />

    <!-- Typography -->
    <FontFamily x:Key="SegoeUIVariable">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>

    <!-- Base TextBlock Style -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIVariable}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Header Action Button Style -->
    <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIVariable}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="#2A2A2A" />
        <Setter Property="Foreground" Value="#E6E6E6" />
        <Setter Property="BorderBrush" Value="#383838" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#363636" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#4A4A4A" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#252525" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent Win11 Blue Button Style -->
    <Style x:Key="FluentAccentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIVariable}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="#60CDFF" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#75D5FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#41B6E6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Dark Button Style -->
    <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIVariable}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="#2B2B2B" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#3D3D3D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#383838" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#4D4D4D" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#222222" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern WinUI 3 Horizontal Pill / Chip Button Style -->
    <Style x:Key="FluentPillFilterButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SegoeUIVariable}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Background" Value="#262626" />
        <Setter Property="Foreground" Value="#C0C0C0" />
        <Setter Property="BorderBrush" Value="#383838" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#333333" />
                            <Setter TargetName="pillBorder" Property="BorderBrush" Value="#4F4F4F" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#1E1E1E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fluent Spoiler Link Button Style (No focus visual dotted border) -->
    <Style x:Key="FluentSpoilerHyperlinkButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2,4,2" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Focusable="False" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WinUI 3 Fluent Card ComboBox Style -->
    <Style x:Key="FluentCardComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="6" />
        <Setter Property="Background" Value="#292929" />
        <Setter Property="BorderBrush" Value="#3D3D3D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,5,10,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                    <Setter Property="Background" Value="#252525" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="ui:ControlHelper.CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WinUI 3 Fluent Card Numeric Input TextBox Style -->
    <Style x:Key="FluentCardNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="6" />
        <Setter Property="Background" Value="#222222" />
        <Setter Property="BorderBrush" Value="#3D3D3D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- WinUI 3 Fluent Stepper Increment/Decrement Button Style -->
    <Style x:Key="FluentStepperButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderActionButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
